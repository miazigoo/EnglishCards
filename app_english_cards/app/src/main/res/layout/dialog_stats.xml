<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📊 Статистика FSRS"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseStats"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_secondary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_menu_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatsTotalCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Всего карточек в базе: 1680"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatsDueToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎯 К повторению сегодня: 0"
            android:textColor="@color/accent_blue"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatsLearned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🟢 Изучено: 0"
            android:textColor="@color/accent_green"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatsHard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🟡 На повторении: 0"
            android:textColor="@color/accent_orange"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/btn_dark_stroke" />

        <TextView
            android:id="@+id/tvStatsTotalReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Всего ответов зафиксировано: 0"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatsSuccessRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Успешных ответов (Good/Easy): 0%"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissStats"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/btn_dark"
        android:text="Закрыть"
        android:textColor="@color/text_primary"
        app:cornerRadius="12dp"
        app:strokeColor="@color/btn_dark_stroke"
        app:strokeWidth="1dp" />

</LinearLayout>
